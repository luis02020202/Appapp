{
  "name": "gmail-intelligence-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Local Gmail analysis and cleanup dashboard (official Gmail API + OAuth 2.0).",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H localhost -p 3000",
    "build": "next build",
    "start": "next start -H localhost -p 3000",
    "typecheck": "tsc --noEmit",
    "gen:key": "node scripts/generate-key.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "google-auth-library": "^9.15.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.10.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0"
  }
}
