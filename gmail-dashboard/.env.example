# Copy to .env and fill in. Never commit .env.

# SQLite file (relative to prisma/schema.prisma). Swap provider + URL for PostgreSQL later.
DATABASE_URL="file:./gmail-dashboard.db"

# OAuth client of type "Web application" from Google Cloud Console → Google Auth Platform → Clients.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Must exactly match an "Authorized redirect URI" of the OAuth client.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# 32 random bytes, base64. Generate with: npm run gen:key
# Encrypts OAuth tokens at rest (AES-256-GCM). Losing it means reconnecting Google, not losing data.
TOKEN_ENCRYPTION_KEY=""
